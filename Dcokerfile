# syntax=docker/dockerfile:1.7
# =========================================================
# CUDA DEVELOPMENT BASE
#
# Build-stage baseline for every CUDA application.
# Tag:   pjsoni/cuda-base:12.4-devel
# Usage: FROM pjsoni/cuda-base:12.4-devel AS build
#
# Starts from your mirror of NVIDIA's devel image, which
# already ships nvcc, the full toolkit headers, cuBLAS +
# libcublas-dev, NCCL + libnccl-dev and the libcuda link stubs.
# Only generic build tooling is added; nothing app-specific
# (ffmpeg, SDL, etc. belong in the app's own build stage).
#
# NOTE for CMake projects: ggml (and some others) decide their
# CUDA arch list BEFORE enable_language(CUDA), so they ignore the
# CUDAARCHS env var below. Always pass it through explicitly:
#   -DCMAKE_CUDA_ARCHITECTURES="${CUDAARCHS}"
# =========================================================

ARG BASE_IMAGE=nvidia/cuda:12.4.1-devel-ubuntu22.04
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
# Ubuntu 22.04 ships CMake 3.22; many CUDA projects now want newer.
ARG CMAKE_VERSION=3.31.6
# Default GPU targets for this fleet: P100 = sm_60, P4/P40 = sm_61.
ARG CUDA_ARCHS="60;61"

LABEL org.opencontainers.image.title="cuda-base-devel" \
      org.opencontainers.image.description="CUDA build baseline (Pascal SM60/SM61)"

# Generic build tooling only. libcublas-dev is NOT installed here
# because NVIDIA's devel image already contains it.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        build-essential \
        ninja-build \
        ccache \
        pkg-config \
        git \
        curl \
        wget \
        ca-certificates \
        python3; \
    rm -rf /var/lib/apt/lists/*

# Current CMake from Kitware's release tarball (x86_64 or aarch64).
RUN set -eux; \
    curl -fsSL "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-$(uname -m).tar.gz" \
        | tar -xz --strip-components=1 -C /usr/local; \
    rm -rf /usr/local/doc /usr/local/man; \
    cmake --version

# Build defaults every project inherits. All are read natively by CMake:
#   CUDAARCHS                    -> default CMAKE_CUDA_ARCHITECTURES (CMake >= 3.20)
#   CMAKE_GENERATOR              -> Ninja instead of Makefiles
#   CMAKE_BUILD_TYPE             -> Release (CMake >= 3.22)
#   CMAKE_<LANG>_COMPILER_LAUNCHER -> ccache, pair with a BuildKit cache mount on /ccache
ENV CUDA_HOME=/usr/local/cuda \
    CUDAARCHS="${CUDA_ARCHS}" \
    CMAKE_GENERATOR=Ninja \
    CMAKE_BUILD_TYPE=Release \
    CMAKE_C_COMPILER_LAUNCHER=ccache \
    CMAKE_CXX_COMPILER_LAUNCHER=ccache \
    CMAKE_CUDA_COMPILER_LAUNCHER=ccache \
    CCACHE_DIR=/ccache \
    CCACHE_MAXSIZE=5G

# Deliberately NOT adding /usr/local/cuda/compat or the libcuda stubs
# to LD_LIBRARY_PATH: either one breaks real GPU access if this image
# is ever run with --gpus for interactive development.

WORKDIR /src
